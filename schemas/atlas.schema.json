{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repo Atlas manifest",
  "description": "源码图谱清单。字段和条件约束由编辑器检查；引用、真实路径和源码锚点由 validate.mjs 检查。",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "output", "project", "modules"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "$schema": { "type": "string", "description": "编辑器使用的 Schema 路径；CLI 始终使用随工具分发的本地 Schema，不读取此地址。" },
    "workspace": { "$ref": "#/$defs/text", "description": "相对清单所在目录的工作区路径，也可为绝对路径。" },
    "output": { "$ref": "#/$defs/text", "pattern": "\\.[hH][tT][mM][lL]$", "description": "工作区内 HTML 输出位置。" },
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "scope", "boundary"],
      "properties": {
        "title": { "$ref": "#/$defs/text" }, "subtitle": { "$ref": "#/$defs/text" },
        "summary": { "$ref": "#/$defs/text" }, "scope": { "$ref": "#/$defs/text" }, "boundary": { "$ref": "#/$defs/text" }
      }
    },
    "modules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/module" } },
    "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
    "views": { "type": "array", "items": { "$ref": "#/$defs/view" } },
    "chains": { "type": "array", "items": { "$ref": "#/$defs/chain" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "coverage": { "type": "array", "items": { "$ref": "#/$defs/coverage" } },
    "tables": { "type": "array", "items": { "$ref": "#/$defs/table" } },
    "routes": { "type": "array", "items": { "$ref": "#/$defs/route" } },
    "flags": { "type": "array", "items": { "$ref": "#/$defs/flag" } },
    "repositories": { "type": "array", "items": { "$ref": "#/$defs/repository" } },
    "fileGroups": { "type": "array", "items": { "$ref": "#/$defs/fileGroup" } },
    "update": { "$ref": "#/$defs/updateState" },
    "review": { "$ref": "#/$defs/reviewState" }
  },
  "anyOf": [
    { "required": ["views"], "properties": { "views": { "minItems": 1 } } },
    { "required": ["chains"], "properties": { "chains": { "minItems": 1 } } }
  ],
  "$defs": {
    "evidenceBinding": {"type": "object", "additionalProperties": false, "required": ["target", "sources"], "properties": {"target": {"type": "string", "pattern": "^/(?:summary|facts|payload|fields|description|guard|effects|transaction|idempotency|compensation)(?:/[^/]+)*$"}, "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}}},
    "transition": {"type": "object", "unevaluatedProperties": false, "allOf": [{"$ref": "#/$defs/runtime"}, {"if": {"required": ["status"], "properties": {"status": {"enum": ["confirmed", "inferred"]}}}, "then": {"required": ["sources"], "properties": {"sources": {"minItems": 1}}}}, {"if": {"required": ["status"], "properties": {"status": {"const": "unverified"}}}, "then": {"required": ["nextCheck"]}}], "required": ["id", "from", "to", "label", "status"], "properties": {"id": {"$ref": "#/$defs/id"}, "from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/text"}, "guard": {"$ref": "#/$defs/text"}, "effects": {"$ref": "#/$defs/texts"}, "async": {"type": "boolean"}, "transaction": {"$ref": "#/$defs/text"}, "idempotency": {"$ref": "#/$defs/text"}, "compensation": {"$ref": "#/$defs/text"}, "status": {"enum": ["confirmed", "inferred", "unverified"]}, "nextCheck": {"$ref": "#/$defs/text"}, "sources": {"$ref": "#/$defs/sources"}, "evidenceBindings": {"type": "array", "items": {"$ref": "#/$defs/evidenceBinding"}}}},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "binding": {"type": "object", "additionalProperties": false, "required": ["candidateSha256", "analysisManifestSha256", "workspaceSha256", "inventorySha256", "baselineSha256", "deltaSha256"], "properties": {"candidateSha256": {"$ref": "#/$defs/hash"}, "analysisManifestSha256": {"$ref": "#/$defs/hash"}, "workspaceSha256": {"$ref": "#/$defs/hash"}, "inventorySha256": {"$ref": "#/$defs/hash"}, "baselineSha256": {"$ref": "#/$defs/hash"}, "deltaSha256": {"$ref": "#/$defs/hash"}}},
    "updateState": {"type": "object", "additionalProperties": false, "properties": {"mode": {"const": "incremental-candidate"}, "generatedAt": {"$ref": "#/$defs/text"}, "baseSnapshot": {"$ref": "#/$defs/path"}, "deltaPath": {"$ref": "#/$defs/path"}, "summary": {"type": "object"}, "impactPaths": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/text"}}}, "impacted": {"$ref": "#/$defs/texts"}, "staleEvidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["key", "entity", "path", "reason"], "properties": {"key": {"$ref": "#/$defs/text"}, "entity": {"$ref": "#/$defs/text"}, "path": {"$ref": "#/$defs/text"}, "reason": {"$ref": "#/$defs/text"}}}}, "unmappedChanges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "status", "reason"], "properties": {"path": {"$ref": "#/$defs/path"}, "status": {"enum": ["added", "modified", "deleted", "renamed"]}, "reason": {"$ref": "#/$defs/text"}}}}, "reviewRequired": {"type": "boolean"}}, "if": {"required": ["mode"]}, "then": {"required": ["generatedAt", "baseSnapshot", "deltaPath", "summary", "impacted", "staleEvidence", "unmappedChanges", "reviewRequired"]}},
    "reviewState": {"type": "object", "additionalProperties": false, "properties": {"version": {"$ref": "#/$defs/text"}, "reviewer": {"$ref": "#/$defs/text"}, "reviewedAt": {"$ref": "#/$defs/text"}, "acceptedAt": {"$ref": "#/$defs/text"}, "binding": {"$ref": "#/$defs/binding"}}, "if": {"required": ["version"]}, "then": {"required": ["reviewer", "reviewedAt", "acceptedAt", "binding"]}},

    "text": { "type": "string", "pattern": "\\S" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "path": { "$ref": "#/$defs/text", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$", "description": "工作区相对路径，使用 /，不含 ..；链接边界由 CLI 检查。" },
    "ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "texts": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["path", "match"],
      "properties": {
        "id": { "$ref": "#/$defs/id", "description": "同一实体内唯一的稳定证据 ID。" },
        "before": { "$ref": "#/$defs/text" }, "after": { "$ref": "#/$defs/text" }, "excerptSha256": { "$ref": "#/$defs/hash" },
        "path": { "$ref": "#/$defs/path" }, "match": { "$ref": "#/$defs/text", "description": "源码中的字面锚点，不是正则表达式。" },
        "length": { "type": "integer", "minimum": 1, "maximum": 60, "default": 8 },
        "occurrence": { "type": "integer", "minimum": 1, "description": "重复锚点选第几次出现，从 1 开始。" },
        "redact": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "需要从公开产物中遮盖的字面值。" }
      }
    },
    "provenance": { "type": "object", "properties": { "evidenceBindings": { "type": "array", "items": { "$ref": "#/$defs/evidenceBinding" } } } },
    "runtime": {
      "type": "object",
      "properties": {
        "freshness": { "enum": ["fresh", "stale", "unresolved", "historical"] },
        "reviewRequired": { "type": "boolean" }, "staleReason": { "type": "string" }
      }
    },
    "module": {
      "type": "object", "unevaluatedProperties": false, "allOf": [{ "$ref": "#/$defs/runtime" }, { "$ref": "#/$defs/provenance" }],
      "required": ["id", "name", "summary", "facts", "sources"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" }, "summary": { "$ref": "#/$defs/text" },
        "category": { "$ref": "#/$defs/text" }, "icon": { "$ref": "#/$defs/text" },
        "facts": { "$ref": "#/$defs/texts" }, "links": { "$ref": "#/$defs/ids" },
        "paths": { "type": "array", "items": { "$ref": "#/$defs/path" }, "description": "模块归属路径，不支持 glob，也不扩大扫描范围。" },
        "sources": { "$ref": "#/$defs/sources", "minItems": 1 }
      }
    },
    "view": {
      "type": "object", "unevaluatedProperties": false, "allOf": [{ "$ref": "#/$defs/runtime" }, { "$ref": "#/$defs/provenance" }],
      "required": ["id", "title", "modules"],
      "properties": {
        "id": { "$ref": "#/$defs/id", "not": { "const": "catalog" } }, "title": { "$ref": "#/$defs/text" },
        "subtitle": { "type": "string" }, "group": { "type": "string" }, "icon": { "$ref": "#/$defs/text" },
        "chain": { "$ref": "#/$defs/id", "description": "从该链路显式 transitions 生成流程图。" },
        "kind": { "enum": ["overview", "flow", "narrative", "sequence", "state", "data", "data_flow", "deployment", "recovery", "dependency", "mindmap", "custom"] },
        "relations": { "$ref": "#/$defs/ids", "description": "显式关系 ID；省略 diagram 时只绘制 data_flow 数据流，不生成依赖或全部关系视图。" },
        "tables": { "$ref": "#/$defs/texts", "description": "本视图中的数据对象名称；ER 节点别名通过 aliases 对应实际名称。" },
        "diagram": { "$ref": "#/$defs/text" }, "mobileDiagram": { "$ref": "#/$defs/text" },
        "bindings": { "type": "array", "items": { "$ref": "#/$defs/diagramBinding" }, "description": "将流程图节点绑定到已取证的业务阶段；节点 ID 在桌面和移动图中保持一致。" },
        "modules": { "$ref": "#/$defs/ids" }, "tags": { "$ref": "#/$defs/texts" }, "sources": { "$ref": "#/$defs/sources" },
        "notes": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } } },
        "aliases": { "type": "object", "propertyNames": { "$ref": "#/$defs/text" }, "additionalProperties": { "$ref": "#/$defs/text" } },
        "useDefaultClasses": { "type": "boolean", "default": true },
        "legend": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["label", "color"], "properties": { "label": { "type": "string" }, "color": { "type": "string", "pattern": "^#[a-fA-F0-9]{6}$" } } } }
      },
      "if": { "anyOf": [{ "required": ["chain"] }, { "required": ["kind"], "properties": { "kind": { "const": "narrative" } } }, { "required": ["relations"], "properties": { "relations": { "minItems": 1 } } }] },
      "else": { "required": ["diagram"] }
    },
    "relation": {
      "type": "object", "unevaluatedProperties": false, "allOf": [{ "$ref": "#/$defs/runtime" }, { "$ref": "#/$defs/provenance" }],
      "required": ["id", "from", "to", "kind", "label", "summary", "sources"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "from": { "$ref": "#/$defs/id" }, "to": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["dependency", "data_flow"] },
        "trigger": { "$ref": "#/$defs/text" }, "async": { "type": "boolean" },
        "label": { "$ref": "#/$defs/text" }, "summary": { "$ref": "#/$defs/text" },
        "payload": { "$ref": "#/$defs/texts" }, "sources": { "$ref": "#/$defs/sources", "minItems": 1 }
      }
    },
    "status": { "enum": ["covered", "partial", "unknown", "not_applicable"] },
    "diagramBinding": {
      "type": "object", "additionalProperties": false, "required": ["node", "chain", "stage"],
      "properties": {
        "node": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$" },
        "chain": { "$ref": "#/$defs/id" }, "stage": { "$ref": "#/$defs/id" }
      }
    },
    "coverageRules": {
      "allOf": [
        { "if": { "required": ["status"], "properties": { "status": { "enum": ["covered", "partial"] } } }, "then": { "required": ["sources"], "properties": { "sources": { "minItems": 1 } } } },
        { "if": { "required": ["status"], "properties": { "status": { "const": "unknown" } } }, "then": { "required": ["nextCheck"], "properties": { "nextCheck": { "$ref": "#/$defs/text" } } } }
      ]
    },
    "stage": {
      "type": "object", "unevaluatedProperties": false, "allOf": [{ "$ref": "#/$defs/runtime" }, { "$ref": "#/$defs/provenance" }, { "$ref": "#/$defs/coverageRules" }],
      "required": ["id", "label", "status", "summary"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/text" }, "summary": { "$ref": "#/$defs/text" },
        "codeExplanation": { "$ref": "#/$defs/text", "description": "可选的 AI 分析注释，解释代码依据；不默认显示在人的图谱阅读界面。" },
        "relations": { "$ref": "#/$defs/ids", "description": "本阶段实际涉及的显式关系；未配置时不推断阶段数据流。" },
        "kind": { "$ref": "#/$defs/text", "examples": ["entry", "authorization", "validation", "orchestration", "read", "write", "side_effect", "publication", "consume", "outcome", "recovery", "custom"], "description": "推荐使用标准阶段类型；保留自定义字符串兼容既有清单。" },
        "status": { "$ref": "#/$defs/status" }, "nextCheck": { "type": "string" },
        "modules": { "$ref": "#/$defs/ids" }, "sources": { "$ref": "#/$defs/sources" }
      }
    },
    "chain": {
      "type": "object", "unevaluatedProperties": false, "allOf": [{ "$ref": "#/$defs/runtime" }, { "$ref": "#/$defs/provenance" }],
      "required": ["id", "title", "summary", "trigger", "outcome", "stages", "sources"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "summary": { "$ref": "#/$defs/text" },
        "kind": { "$ref": "#/$defs/text" }, "trigger": { "$ref": "#/$defs/text" }, "outcome": { "$ref": "#/$defs/text" },
        "modules": { "$ref": "#/$defs/ids" }, "views": { "$ref": "#/$defs/ids" },
        "transitions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/transition" } },
        "stages": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/stage" } },
        "sources": { "$ref": "#/$defs/sources", "minItems": 1 }
      }
    },
    "finding": {
      "type": "object", "unevaluatedProperties": false, "allOf": [{ "$ref": "#/$defs/runtime" }, { "$ref": "#/$defs/provenance" }],
      "required": ["id", "title", "summary", "kind", "status", "sources"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "summary": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["fact", "risk", "gap", "decision"] }, "status": { "enum": ["confirmed", "inferred", "unverified"] },
        "impact": { "type": "string" }, "nextCheck": { "type": "string" }, "modules": { "$ref": "#/$defs/ids" },
        "sources": { "$ref": "#/$defs/sources", "minItems": 1 }
      },
      "if": { "required": ["status"], "properties": { "status": { "const": "unverified" } } },
      "then": { "required": ["nextCheck"], "properties": { "nextCheck": { "$ref": "#/$defs/text" } } }
    },
    "coverage": {
      "type": "object", "unevaluatedProperties": false, "allOf": [{ "$ref": "#/$defs/runtime" }, { "$ref": "#/$defs/provenance" }, { "$ref": "#/$defs/coverageRules" }],
      "required": ["id", "area", "summary", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "area": { "$ref": "#/$defs/text" }, "summary": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/status" }, "nextCheck": { "type": "string" },
        "modules": { "$ref": "#/$defs/ids" }, "sources": { "$ref": "#/$defs/sources" }
      }
    },
    "table": {
      "type": "object", "unevaluatedProperties": false, "allOf": [{ "$ref": "#/$defs/runtime" }, { "$ref": "#/$defs/provenance" }],
      "required": ["name", "title", "kind", "description", "sources"],
      "properties": {
        "name": { "$ref": "#/$defs/text" }, "title": { "$ref": "#/$defs/text" }, "kind": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" }, "sources": { "$ref": "#/$defs/sources", "minItems": 1 },
        "modules": { "$ref": "#/$defs/ids" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/dataField" } }
      }
    },
    "dataField": {
      "type": "object", "additionalProperties": false, "required": ["name", "type", "description"],
      "properties": {
        "name": { "$ref": "#/$defs/text" }, "type": { "$ref": "#/$defs/text" }, "description": { "$ref": "#/$defs/text" },
        "evidenceBindings": { "type": "array", "items": { "$ref": "#/$defs/evidenceBinding" } },
        "key": { "enum": ["PK", "FK", "UK", "KEY"] },
        "references": {
          "type": "object", "additionalProperties": false, "required": ["table", "field", "kind"],
          "properties": { "table": { "$ref": "#/$defs/text" }, "field": { "$ref": "#/$defs/text" }, "kind": { "enum": ["logical", "foreign_key"] } }
        }
      }
    },
    "route": {
      "type": "object", "unevaluatedProperties": false, "allOf": [{ "$ref": "#/$defs/runtime" }, { "$ref": "#/$defs/provenance" }],
      "required": ["prefix", "name", "description", "sources"],
      "properties": {
        "prefix": { "$ref": "#/$defs/text" }, "name": { "$ref": "#/$defs/text" }, "kind": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" }, "sources": { "$ref": "#/$defs/sources", "minItems": 1 }
      }
    },
    "flag": {
      "type": "object", "unevaluatedProperties": false, "allOf": [{ "$ref": "#/$defs/runtime" }, { "$ref": "#/$defs/provenance" }],
      "required": ["name", "value", "description", "sources"],
      "properties": {
        "name": { "$ref": "#/$defs/text" }, "value": {}, "description": { "$ref": "#/$defs/text" },
        "sources": { "$ref": "#/$defs/sources", "minItems": 1 }
      }
    },
    "repository": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": { "name": { "$ref": "#/$defs/text" }, "path": { "$ref": "#/$defs/path" } }
    },
    "fileGroup": {
      "type": "object", "additionalProperties": false, "required": ["name", "paths", "extensions"],
      "properties": {
        "name": { "$ref": "#/$defs/text" }, "paths": { "type": "array", "items": { "$ref": "#/$defs/path" } },
        "extensions": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^\\." } },
        "exclude": { "$ref": "#/$defs/texts" }
      }
    }
  }
}
